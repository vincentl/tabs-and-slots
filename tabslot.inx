<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Tabs &amp; Slots</name>
    <id>org.inkscape.filter.tabslot</id>

    <param name="tab" type="notebook">
        <page name="shape" gui-text="Split/Join">
            <label>Split a rectangle into sides before adding tabs.</label>
            <label>Join tabbed sides and optional inner holes into one object.</label>
            <separator />
            <param name="action" type="optiongroup" appearance="radio" gui-text="Action">
                <option value="split">Split into Sides</option>
                <option value="join">Join Sides and Holes</option>
            </param>
        </page>
        <page name="edge" gui-text="Tabs &amp; Slots">
            <label>Add tabs or slots along the selected side</label>
            <separator />
            <param name="material" type="float" gui-text="Material Thickness in mm">3.0</param>
            <param name="kerf" type="int" gui-text="Laser Kerf in µm" min="0" max="1000">160</param>
            <param name="count" type="int" gui-text="Steps" min="1" max="1024">2</param>
            <param name="operation" type="optiongroup" appearance="radio/combo" gui-text="Operation">
                <option value="slot">Create Slots</option>
                <option value="tab">Create Tabs</option>
            </param>
            <param name="normal" type="optiongroup" appearance="radio/combo" gui-text="Normal Vector">
                <option value="positive">Positive</option>
                <option value="negative">Negative</option>
            </param>
            <param name="phantom" type="optiongroup" appearance="radio/combo" gui-text="Phantom Material">
                <option value="none">None</option>
                <option value="both">Both Ends</option>
                <option value="start">Start End</option>
                <option value="finish">Finish End</option>
            </param>
            <separator />
            <param name="slots" type="bool" gui-text="Add a slot for each tab">false</param>
        </page>
    </param>

    <effect needs-live-preview="true">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Modify Path"/>
        </effects-menu>
    </effect>
    <script>
        <command location="extensions" interpreter="python">tabslot.py</command>
    </script>
</inkscape-extension>
